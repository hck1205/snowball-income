# ---- 시크릿 / 환경변수 (최우선) ----
.env
.env.*
!.env.example
!.env.sample
*.local
*.pem
*.key
*.p12
*.pfx
*.key.json
service-account*.json
serviceAccount*.json
credentials.json
gha-creds-*.json
.npmrc
.netrc

# ---- 의존성 ----
node_modules/

# ---- 빌드 / 캐시 산출물 ----
dist/
build/
*.tsbuildinfo
.vite/
.eslintcache
.cache/
__pycache__/
*.py[cod]

# ---- 테스트 / 커버리지 ----
coverage/
.nyc_output/
test-results/
playwright-report/

# ---- 자동 생성 인덱스 (npm run index 로 각자 로컬에서 생성) ----
.index/

# ---- codegraph 지식 그래프 (codegraph init 로 각자 로컬에서 생성, 파일 와처 자동 갱신) ----
.codegraph/

# ---- graphify 지식 그래프 (graphify update . 로 각자 로컬 생성) ----
graphify-out/

# ---- 세션 핸드오프 (로컬 전용 — 계정 id·이메일 등 운영 메모가 들어간다. 공개 레포에 올리지 않는다) ----
HANDOFF.md

# ---- 로그 / 런타임 ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid

# ---- 임시 / 백업 ----
tmp/
temp/
*.tmp
*.bak
*.orig
*~

# ---- 에디터 / OS ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
Desktop.ini

# ---- Claude Code ----
# .claude/agents/, .claude/hooks/, .claude/settings.json 은 팀 공유(커밋 대상).
# 개인 로컬 설정만 무시한다.
.claude/settings.local.json
# 에이전트 worktree 산출물 — .git/worktrees/ 에 등록되지만 내용은 각자 로컬(추적 대상 아님).
.claude/worktrees/
.vercel
.env*

# uiprobe 스크린샷 세트 (tools/dev/shotset.mjs 생성물 — 비교용, 커밋하지 않는다)
.shots/

# npx skills 가 만드는 심볼릭 링크 — 실체는 .agents/skills/ 에 커밋돼 있다.
# 링크가 절대경로라 커밋하면 다른 PC에서 깨진다(`npx skills add` 가 다시 만든다).
#
# 설치 스킬은 계속 늘어나므로(9 → 23) 이름을 나열하면 목록이 매번 낡는다.
# 그래서 **전부 무시하고 레포 소유 스킬만 되살린다** — 되살릴 목록은 우리가 만든 것뿐이라 안정적이다.
# 새 스킬을 `npx skills add` 로 설치하면 여기를 고칠 필요가 없다.
.claude/skills/*
!.claude/skills/dev-process/
!.claude/skills/feature/
!.claude/skills/new-ticker-page/
!.claude/skills/portfolio-post/
!.claude/skills/refresh-data/
!.claude/skills/ship/
